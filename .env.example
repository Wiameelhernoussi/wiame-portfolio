# Application Environment
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change_this_to_a_super_secret_key_at_least_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (SQLite default for local dev, PostgreSQL for production/docker)
DATABASE_URL=sqlite:///./portfolio.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://wiame_admin:superpassword@localhost:5432/wiame_portfolio

# Storage Provider: 'local' (development) or 'cloudinary' (production)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# Cloudinary Configuration (required if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Initial Admin Credentials (used during database seed — change these before deploying!)
FIRST_SUPERUSER_EMAIL=your-admin-email@example.com
FIRST_SUPERUSER_PASSWORD=YourStrongPasswordHere!

# SMTP Email Dispatch (Optional for Contact Form notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
NOTIFICATION_EMAIL=
